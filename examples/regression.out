sysr> SELECT s.age, COUNT(*) AS n, AVG(g.grade) AS avg_grade, MAX(g.grade) AS best
FROM students s JOIN grades g ON s.id = g.student_id
GROUP BY s.age ORDER BY s.age;
+-------+-----+-----------+------+
| s.age | n   | avg_grade | best |
